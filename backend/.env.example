# ============================================================================
# zkde.fi Backend — Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================================

# -- Core --
APP_ENV=development                    # development | staging | production
STARKNET_RPC_URL=https://starknet-sepolia-rpc.publicnode.com
STARKNET_RPC_URL_V08=                  # Optional v0.8 RPC fallback
STARKNET_CHAIN_ID=SN_SEPOLIA

# -- Admin Auth --
ADMIN_API_KEY=                         # Required. Protects all admin-only endpoints

# -- Privacy Vault Admin (on-chain Merkle tree) --
FULL_PRIVACY_MERKLE_TREE_ADMIN_ADDRESS=
FULL_PRIVACY_MERKLE_TREE_ADMIN_PRIVATE_KEY=
FULL_PRIVACY_MERKLE_TREE_ADDRESS=
FULL_PRIVACY_POOL_V2_ADDRESS=

# -- Executor (strategy deployments / tx submission) --
EXECUTOR_ADDRESS=
EXECUTOR_PRIVATE_KEY=
EXECUTOR_RPC_URL=                      # Falls back to STARKNET_RPC_URL
EXECUTOR_LIVE_SUBMIT=false             # Set true to submit real txns

# -- Relayer (meta-tx relay) --
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=
RELAYER_RPC_URL=
RELAYER_DRY_RUN=true

# -- Rebalancer --
REBALANCER_SIGNER_ADDRESS=
REBALANCER_SIGNER_PRIVATE_KEY=

# -- Contract Addresses (Starknet Sepolia) --
EKUBO_CORE_ADDRESS=0x00000005dd3D2F4429AF886cD1a3b08289DBcEa99A294197E9eB43b0e0325b4b
EKUBO_ROUTER_ADDRESS=0x0199741822c2dc722f6f605204f35e56dbc23bceed54818168c4c49e4c8393c3
EKUBO_POSITIONS_FILE=ekubo_positions.json
LENDING_POOL_ADDRESS=
MODEL_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
SESSION_KEY_MANAGER_ADDRESS=
SELECTIVE_DISCLOSURE_ADDRESS=
CONSTRAINT_RECEIPT_ADDRESS=
BATCH_VERIFIER_ADDRESS=
GARAGA_VERIFIER_ADDRESS=
# ZkmlVerifier (ModelBridge-capable; use for verify_model_bridge_proof)
ZKML_VERIFIER_ADDRESS=0x068abd64a4a78172a5ee15a30bbe614257d62482f07d3ff7fdb72da5aad08923

# -- External APIs --
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
OPENAI_API_KEY=                        # For LLM consensus (optional)
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# -- Feature Flags --
EKUBO_LP_ENABLED=true
PRIVACY_UNIFIED_ROUTES_ENABLED=true
LEDGER_ENABLED=true
ZKDEFI_REQUIRE_REAL_PROOFS=false
DEV_STATE_RESET_ENABLED=false

# -- Native KZG (Path B strict mode) --
NATIVE_KZG_REQUIRE_REAL_EZKL=true
NATIVE_KZG_REQUIRE_MPCHECK=true
# -- ModelBridge strict mode --
MODELBRIDGE_REQUIRE_REAL_GROTH16=true
EZKL_KZG_BUNDLE_FILE=
EZKL_KZG_BUNDLE_DIR=
# Optional: run real extractor (proof+vk/settings/srs -> EVM trace -> kzg_mpcheck_bundle)
EZKL_KZG_BUNDLE_EXTRACTOR_CMD=

# -- Optional: LLM provider --
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
OLLAMA_MODEL=

# -- Redis (for rate limiter / caching) --
REDIS_URL=
