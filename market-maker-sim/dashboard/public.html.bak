<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>zkDeFi Public Dashboard</title>
  <style>
    :root {
      --bg: #060c16;
      --bg-elev: #0d1729;
      --card: #111f35;
      --card-2: #0f1930;
      --line: #203252;
      --text: #e6f0ff;
      --muted: #93a6c8;
      --green: #22c55e;
      --amber: #f59e0b;
      --red: #ef4444;
      --cyan: #22d3ee;
      --blue: #60a5fa;
      --violet: #818cf8;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--text);
      background:
        radial-gradient(1200px 500px at 95% -5%, rgba(34, 211, 238, 0.11), transparent),
        radial-gradient(900px 500px at -10% 0%, rgba(129, 140, 248, 0.14), transparent),
        linear-gradient(180deg, #050a12 0%, #070f1d 45%, #060b15 100%);
      font-family: "Space Grotesk", "Segoe UI", sans-serif;
      min-height: 100vh;
    }

    .wrap {
      max-width: 1320px;
      margin: 0 auto;
      padding: 22px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 16px;
    }

    .title h1 {
      margin: 0;
      font-size: 26px;
      letter-spacing: 0.2px;
    }

    .subtitle {
      margin-top: 6px;
      font-size: 12px;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      display: inline-block;
    }

    .dot.online { background: var(--green); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.18); }
    .dot.offline { background: var(--red); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0.15); }

    .top-right {
      text-align: right;
      font-size: 12px;
      color: var(--muted);
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: flex-end;
    }

    .pill {
      border: 1px solid var(--line);
      background: #0c1530;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      color: #bfd6ff;
    }

    .nav-links {
      display: flex;
      gap: 8px;
    }

    .nav-links a {
      color: #d6e6ff;
      text-decoration: none;
      border: 1px solid #294068;
      background: #0e1b34;
      padding: 6px 11px;
      border-radius: 10px;
      font-size: 12px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .stat {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 11px;
    }

    .stat .k {
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }

    .stat .v {
      margin-top: 4px;
      font-size: 20px;
      font-weight: 700;
    }

    .stat .s {
      margin-top: 3px;
      font-size: 11px;
      color: var(--muted);
    }

    .layout {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    .card {
      background: var(--card-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px;
    }

    .card h2 {
      margin: 0;
      font-size: 15px;
      letter-spacing: 0.25px;
    }

    .hint {
      margin-top: 6px;
      color: var(--muted);
      font-size: 12px;
    }

    .progress {
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: #10203a;
      border: 1px solid #1f3659;
      overflow: hidden;
      margin-top: 9px;
    }

    .progress > span {
      display: block;
      height: 100%;
      background: linear-gradient(90deg, #22d3ee, #22c55e);
      width: 0%;
    }

    .mini {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin-top: 10px;
    }

    .mini .m {
      background: #0e1830;
      border: 1px solid #1e3353;
      border-radius: 10px;
      padding: 8px;
      min-height: 58px;
    }

    .mini .m .k { font-size: 10px; color: var(--muted); text-transform: uppercase; }
    .mini .m .v { margin-top: 4px; font-size: 16px; font-weight: 700; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      font-size: 12px;
    }

    th, td {
      text-align: left;
      padding: 8px 6px;
      border-bottom: 1px solid #1b2c49;
      vertical-align: top;
    }

    th {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .mono {
      font-family: "IBM Plex Mono", "SFMono-Regular", monospace;
    }

    .ok { color: var(--green); }
    .warn { color: var(--amber); }
    .bad { color: var(--red); }

    .activity {
      max-height: 280px;
      overflow: auto;
      margin-top: 10px;
      border: 1px solid #1b2c49;
      border-radius: 10px;
      background: #091426;
    }

    .activity-item {
      border-bottom: 1px solid #172744;
      padding: 8px 10px;
      font-size: 12px;
    }

    .activity-item:last-child { border-bottom: 0; }

    .feed {
      max-height: 280px;
      overflow: auto;
      border: 1px solid #1b2c49;
      border-radius: 10px;
      background: #081122;
      margin-top: 10px;
      font-size: 11px;
      font-family: "IBM Plex Mono", "SFMono-Regular", monospace;
    }

    .event {
      border-bottom: 1px solid #15233d;
      padding: 8px 10px;
      color: #cadaff;
    }

    .event:last-child { border-bottom: 0; }

    .section {
      margin-top: 12px;
    }

    .footer {
      margin-top: 18px;
      color: #7f93b8;
      font-size: 11px;
      text-align: center;
    }

    @media (max-width: 1200px) {
      .stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .layout { grid-template-columns: 1fr; }
    }

    @media (max-width: 700px) {
      .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .mini { grid-template-columns: 1fr; }
      .header { flex-direction: column; }
      .top-right { align-items: flex-start; text-align: left; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <div class="title">
        <h1>zkDeFi Public Control Surface</h1>
        <div class="subtitle">
          <span id="connDot" class="dot offline"></span>
          <span id="connLabel">connecting...</span>
          <span class="pill">Sepolia</span>
        </div>
      </div>
      <div class="top-right">
        <div id="blockLabel">Block: --</div>
        <div class="nav-links">
          <a href="/dashboard">Public</a>
          <a href="/dashboard/admin">Admin</a>
        </div>
      </div>
    </div>

    <div class="stats-grid" id="statsGrid"></div>

    <div class="layout">
      <div class="card">
        <h2>Pool Coverage + Volume Targets</h2>
        <div class="hint">Tracks whether swap flow has touched most targeted pools and how far each target pair is from daily volume goals.</div>
        <div class="progress"><span id="coverageBar"></span></div>
        <div class="mini" id="coverageMini"></div>
        <table>
          <thead>
            <tr>
              <th>Pair</th>
              <th>Target</th>
              <th>Current</th>
              <th>Deficit</th>
              <th>Coverage</th>
            </tr>
          </thead>
          <tbody id="targetRows"></tbody>
        </table>
      </div>

      <div class="card">
        <h2>Latest Coordination Actions</h2>
        <div class="hint">Recent automated decisions (coverage swaps, recenter actions, and ramp swaps).</div>
        <div class="activity" id="coordActions"></div>
      </div>
    </div>

    <div class="section card">
      <h2>Pools</h2>
      <div class="hint">Coverage shows whether swap flow has touched each pool in current runtime.</div>
      <table>
        <thead>
          <tr>
            <th>Pair</th>
            <th>TVL</th>
            <th>24h Vol</th>
            <th>Bot Vol</th>
            <th>Swap Hits</th>
            <th>Tick</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="poolRows"></tbody>
      </table>
    </div>

    <div class="section card">
      <h2>Event Feed</h2>
      <div class="feed" id="eventFeed"></div>
    </div>

    <div class="footer">zkDeFi market maker monitor | data: /public/state + /public/events</div>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const fmtUsd = (v) => "$" + Number(v || 0).toLocaleString(undefined, { maximumFractionDigits: 2 });
    const fmtInt = (v) => Number(v || 0).toLocaleString();
    const API_BASE = (window.location.port === "8099" || window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1")
      ? ""
      : "/sim";

    let cachedEvents = [];

    function setConnection(ok) {
      const dot = $("connDot");
      const label = $("connLabel");
      dot.className = ok ? "dot online" : "dot offline";
      label.textContent = ok ? "live" : "disconnected";
    }

    function computeCoverage(state) {
      const pools = state?.pools || [];
      const swapUsage = state?.bots?.swap?.pool_usage || {};
      const policy = state?.coordination_policy || {};

      const targetPairs = Array.isArray(policy.target_pairs) && policy.target_pairs.length
        ? policy.target_pairs.map((p) => String(p || "").toLowerCase())
        : pools.map((p) => String(p.name || "").toLowerCase());

      const uniqueTargets = Array.from(new Set(targetPairs.filter(Boolean)));
      const covered = uniqueTargets.filter((pair) => Number(swapUsage[pair] || swapUsage[pair.toUpperCase()] || 0) > 0);
      const ratio = covered.length / Math.max(1, uniqueTargets.length);

      return {
        targetPairs: uniqueTargets,
        coveredSet: new Set(covered),
        covered: covered.length,
        targeted: uniqueTargets.length,
        ratio,
      };
    }

    function renderStats(state) {
      const coverage = computeCoverage(state);
      const pools = state?.pools || [];
      const botVolume = pools.reduce((sum, p) => sum + Number(p.bot_generated_volume_usd || 0), 0);
      const txs = Object.values(state?.bots || {}).reduce((sum, bot) => sum + Number(bot?.total || 0), 0);
      const coord = state?.coordination || {};

      const stats = [
        { k: "Total TVL", v: fmtUsd(state?.total_tvl_usd || 0), s: "on-chain pool balances" },
        { k: "Pools Active", v: `${state?.initialized_pools || 0}/${state?.total_pools || 0}`, s: "initialized/registered" },
        { k: "Pool Coverage", v: `${coverage.covered}/${coverage.targeted}`, s: `${(coverage.ratio * 100).toFixed(1)}% touched` },
        { k: "Bot Transactions", v: fmtInt(txs), s: "swap + lp + limit" },
        { k: "Bot Volume", v: fmtUsd(botVolume), s: "display overlay" },
        { k: "Coordination", v: fmtInt(coord.cycles || 0), s: `last: ${coord.last_result || "idle"}` },
      ];

      $("statsGrid").innerHTML = stats.map((m) => `
        <div class="stat">
          <div class="k">${m.k}</div>
          <div class="v">${m.v}</div>
          <div class="s">${m.s}</div>
        </div>
      `).join("");

      const pct = Math.max(0, Math.min(100, coverage.ratio * 100));
      $("coverageBar").style.width = `${pct}%`;

      const uncovered = Math.max(0, coverage.targeted - coverage.covered);
      const policy = state?.coordination_policy || {};
      $("coverageMini").innerHTML = `
        <div class="m"><div class="k">Target Coverage</div><div class="v">${Math.round((Number(policy.min_pool_coverage_ratio || 0) * 100))}%</div></div>
        <div class="m"><div class="k">Current Coverage</div><div class="v">${pct.toFixed(1)}%</div></div>
        <div class="m"><div class="k">Uncovered Pools</div><div class="v">${uncovered}</div></div>
      `;

      return coverage;
    }

    function renderTargetTable(state, coverage) {
      const pools = state?.pools || [];
      const poolMap = new Map(pools.map((p) => [String(p.name || "").toLowerCase(), p]));
      const usage = state?.bots?.swap?.pool_usage || {};
      const policy = state?.coordination_policy || {};
      const targets = policy.volume_targets_usd || {};

      const rows = Object.entries(targets).map(([pairKey, target]) => {
        const key = String(pairKey || "").toLowerCase();
        const pool = poolMap.get(key) || {};
        const current = Number(pool.volume_24h_usd || 0);
        const deficit = Math.max(0, Number(target || 0) - current);
        const hits = Number(usage[key] || 0);
        const isCovered = coverage.coveredSet.has(key);
        return {
          pair: pool.name || pairKey,
          target: Number(target || 0),
          current,
          deficit,
          hits,
          isCovered,
        };
      }).sort((a, b) => b.deficit - a.deficit);

      $("targetRows").innerHTML = rows.length ? rows.map((r) => `
        <tr>
          <td>${r.pair}</td>
          <td class="mono">${fmtUsd(r.target)}</td>
          <td class="mono">${fmtUsd(r.current)}</td>
          <td class="mono ${r.deficit > 0 ? "warn" : "ok"}">${fmtUsd(r.deficit)}</td>
          <td class="${r.isCovered ? "ok" : "warn"}">${r.isCovered ? `hit (${r.hits})` : "not hit"}</td>
        </tr>
      `).join("") : `<tr><td colspan="5" class="hint">No volume targets configured.</td></tr>`;
    }

    function renderPools(state, coverage) {
      const pools = (state?.pools || []).slice().sort((a, b) => Number(b.tvl_usd || 0) - Number(a.tvl_usd || 0));
      const usage = state?.bots?.swap?.pool_usage || {};

      $("poolRows").innerHTML = pools.map((p) => {
        const key = String(p.name || "").toLowerCase();
        const hits = Number(usage[key] || 0);
        const covered = coverage.coveredSet.has(key);
        const status = !p.initialized ? "not-init" : (covered ? "covered" : "uncovered");
        const statusClass = !p.initialized ? "bad" : (covered ? "ok" : "warn");

        return `
          <tr>
            <td>${p.name || "--"}</td>
            <td class="mono">${fmtUsd(p.tvl_usd || 0)}</td>
            <td class="mono">${fmtUsd(p.volume_24h_usd || 0)}</td>
            <td class="mono">${fmtUsd(p.bot_generated_volume_usd || 0)}</td>
            <td class="mono">${fmtInt(hits)}</td>
            <td class="mono">${fmtInt(p.tick || 0)}</td>
            <td class="${statusClass}">${status}</td>
          </tr>
        `;
      }).join("");
    }

    function renderCoordActions(state) {
      const actions = state?.coordination?.last_actions || [];
      if (!actions.length) {
        $("coordActions").innerHTML = `<div class="activity-item hint">No coordination actions yet.</div>`;
        return;
      }

      $("coordActions").innerHTML = actions.slice().reverse().map((a) => {
        const action = a.action || "action";
        const pair = a.pair || "--";
        const result = a.success === true ? "ok" : (a.success === false ? "failed" : "info");
        const cls = result === "ok" ? "ok" : (result === "failed" ? "bad" : "warn");
        const details = [
          a.side ? `side=${a.side}` : "",
          a.size_multiplier ? `mult=${a.size_multiplier}` : "",
          a.behavior ? `profile=${a.behavior}` : "",
          a.deficit_usd != null ? `deficit=${fmtUsd(a.deficit_usd)}` : "",
        ].filter(Boolean).join(" | ");

        return `<div class="activity-item"><span class="mono">${action}</span> on <b>${pair}</b> <span class="${cls}">${result}</span>${details ? `<div class="hint">${details}</div>` : ""}</div>`;
      }).join("");
    }

    function renderEvents(items) {
      const list = (items || []).slice(-120).reverse();
      if (!list.length) {
        $("eventFeed").innerHTML = `<div class="event">No events yet.</div>`;
        return;
      }
      $("eventFeed").innerHTML = list.map((ev) => {
        const ts = new Date(Number(ev.ts || 0) * 1000);
        const hh = ts.toISOString().slice(11, 19);
        return `<div class="event">[${hh}] <b>${ev.category || "event"}</b> ${ev.message || ""}</div>`;
      }).join("");
    }

    async function loadEvents() {
      try {
        const res = await fetch(`${API_BASE}/public/events?limit=250`);
        const data = await res.json();
        cachedEvents = data.items || [];
      } catch (_err) {
        cachedEvents = [];
      }
    }

    async function refresh() {
      try {
        const res = await fetch(`${API_BASE}/public/state`);
        const state = await res.json();

        setConnection(true);
        $("blockLabel").textContent = `Block: ${fmtInt(state.block_number || 0)}`;

        const coverage = renderStats(state);
        renderTargetTable(state, coverage);
        renderPools(state, coverage);
        renderCoordActions(state);
        renderEvents(cachedEvents);
      } catch (_err) {
        setConnection(false);
      }
    }

    async function boot() {
      await loadEvents();
      await refresh();
      setInterval(loadEvents, 8000);
      setInterval(refresh, 4500);
    }

    boot();
  </script>
</body>
</html>
