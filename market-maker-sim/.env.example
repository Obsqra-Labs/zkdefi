# ── Server ────────────────────────────────────────────────────────────────────
MM_SIM_HOST=0.0.0.0
MM_SIM_PORT=8099
MM_SIM_ADMIN_KEY=dev-admin-key
MM_SIM_CORS=http://localhost:3001,http://127.0.0.1:3001
MM_SIM_EKUBO_CHAIN_ID=0x534e5f4d41494f
MM_SIM_POLL_INTERVAL_SEC=10.0

# ── Starknet RPC ─────────────────────────────────────────────────────────────
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# ── Bot Wallet (required for real on-chain activity) ─────────────────────────
BOT_ACCOUNT_ADDRESS=0xYOUR_SEPOLIA_ACCOUNT_ADDRESS
BOT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Swap Bot ─────────────────────────────────────────────────────────────────
SWAP_BOT_ENABLED_ON_START=true
SWAP_BOT_INTERVAL_SEC=25
SWAP_BOT_MIN_AMOUNT=0.002
SWAP_BOT_MAX_AMOUNT=0.02

# ── LP Bot ───────────────────────────────────────────────────────────────────
LP_BOT_ENABLED_ON_START=true
LP_BOT_INTERVAL_SEC=300
LP_BOT_AMOUNT0=0.005
LP_BOT_AMOUNT1=0.005
LP_BOT_TICK_WIDTH=2000

# ── Limit Order Bot ─────────────────────────────────────────────────────────
LIMIT_BOT_ENABLED_ON_START=true
LIMIT_BOT_INTERVAL_SEC=180
LIMIT_BOT_AMOUNT=0.002

# ── Coordination Policy (liquidity coverage + stale recenter) ─────────────
MM_SIM_COORD_ENABLED=true
MM_SIM_COORD_CYCLE_SEC=180
MM_SIM_COORD_MIN_ACTIVE_LP_PER_PAIR=1
MM_SIM_COORD_MAX_ACTIONS_PER_CYCLE=4
MM_SIM_COORD_AUTO_CLOSE_STALE=true
MM_SIM_COORD_AUTO_RECENTER=true
MM_SIM_COORD_LIMIT_SUPPORT_ENABLED=true
# Optional comma-separated list. Empty = all tracked pairs.
MM_SIM_COORD_TARGET_PAIRS=
MM_SIM_COORD_VOLUME_RAMP_ENABLED=true
MM_SIM_COORD_MAX_SWAP_ACTIONS_PER_CYCLE=3
MM_SIM_COORD_COVERAGE_BOOST_ENABLED=true
MM_SIM_COORD_MIN_POOL_COVERAGE_RATIO=0.8
MM_SIM_COORD_MAX_COVERAGE_SWAP_ACTIONS_PER_CYCLE=2
MM_SIM_COORD_MIN_SWAP_SIZE_MULTIPLIER=1.0
MM_SIM_COORD_MAX_SWAP_SIZE_MULTIPLIER=6.0
# Prioritize these pairs first when deficits exist.
MM_SIM_COORD_PRIMARY_VOLUME_PAIRS=zkdAI/zkdETH
# Pair-specific daily targets (USD-equivalent overlay target from /public/state pool volume_24h_usd)
MM_SIM_COORD_VOLUME_TARGETS_USD=zkdAI/zkdETH:200000,STRK/zkdETH:75000,zkdAI/STRK:75000

# Boundary recovery aggressiveness (seconds between recovery attempts per pair)
MM_SIM_BOUNDARY_RECOVERY_COOLDOWN_SEC=240
