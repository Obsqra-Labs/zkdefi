# Starknet RPC (Sepolia)
NEXT_PUBLIC_STARKNET_RPC=https://starknet-sepolia.g.alchemy.com/v2/<API_KEY>

# ReceiptRegistry contract (Sepolia)
NEXT_PUBLIC_RECEIPTOS_CONTRACT=0x0544ef8cbf8bf1ac7987bc0d2bb211434d515fbe10bab65f36e0f761c79bbdff

# Existing zkdefi backend API base URL
NEXT_PUBLIC_ZKDEFI_API_URL=http://localhost:8003

# Server-only: attester key registered in the ReceiptRegistry
# This key's public key must match what's stored at get_attester_pubkey()
RECEIPTOS_ATTESTER_SK=0x12345

# Server-only: Starknet account that submits claim transactions
# This can be any funded Sepolia account — it pays the gas fee
RECEIPTOS_SUBMITTER_ADDRESS=0x05fe812551bec726f1bf5026d5fb88f06ed411a753fb4468f9e19ebf8ced1b3d
RECEIPTOS_SUBMITTER_PK=<raw-private-key-hex>
